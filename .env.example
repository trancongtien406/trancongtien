# Website API token used by trusted automation. Set the same value in the Next.js app process.
CONTENT_AUTOMATION_TOKEN=

# PostgreSQL (required). Local / VPS host example:
# postgresql://postgres:123456@127.0.0.1:5432/trancongtien?schema=public&connection_limit=10
# Empty password: postgresql://postgres@127.0.0.1:5432/trancongtien?schema=public&connection_limit=10
DATABASE_URL=postgresql://mac:@localhost:5432/trancongtien?schema=public&connection_limit=10
SESSION_SECRET=
ADMIN_EMAIL=admin@trancongtien.com
ADMIN_PASSWORD=
ADMIN_NAME=Trần Công Tiến

# Cloudflare R2. Required in production; local filesystem is development-only fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.trancongtien.com

# SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tran Cong Tien <hello@trancongtien.com>
NOTIFY_EMAIL=hello@trancongtien.com
NOTIFY_PHONE=

# Website process. Use trancongtien.com -> 127.0.0.1:3342.
WEB_PORT=3342
PORT=3342
SITE_ORIGIN=https://trancongtien.com

# Optional analytics (leave empty to disable)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional LLM for estimator AI extraction (also configurable in Admin → Cài đặt)
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1

# Tích hợp: ưu tiên cấu hình trong Admin → Cài đặt.
# Biến env dưới đây chỉ là fallback khi Settings trống.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public MCP access token used by ChatGPT/custom connector. Use a different long random value.
MCP_ACCESS_TOKEN=
MCP_PORT=3343
# MCP process. Use mcp.trancongtien.com -> 127.0.0.1:3343.

# Optional extra hosts for upload_cover / create_blog_draft image_url (comma-separated).
MCP_ALLOWED_IMAGE_HOSTS=
